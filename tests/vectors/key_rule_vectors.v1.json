{
 "schema": "requisition_key_rule_vectors.v1",
 "rule": "LabKeyRule.standing/3 (lib/autonomous_agency/authority/execute_api/lab_key_rule.ex)",
 "note": "ONE vector file for every verifier. A null entry member means the member is ABSENT from the key entry. Each verifier test builds a real signed record whose signed occurred_at is occurred_at (absent when null) under an entry with these members, and expects pass (expect null) or a refusal naming the reason. Order of checks: status, window, signer. The `documents` section is the bound on the READERS: every strict JSON reader refuses nesting deeper than max_depth containers and any integer outside +-max_integer, with its own refusal (never a traceback); `ok` documents are read. The ed25519_* sections are the KEY MATERIAL rule: a public key is accepted only if it decodes canonically, is not small-order and [L]P is the identity (prime-order subgroup); a signature whose R is not a canonical point encoding or whose S >= L is refused; the two ed25519_triples are the measured cases on which the deployed verifiers disagreed (h mod L versus full h).",
 "reasons": [
  "key_revoked",
  "key_status_unusable",
  "key_window_unreadable",
  "signed_instant_unreadable",
  "key_not_valid_at_signing",
  "signer_not_accepted"
 ],
